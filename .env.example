# Copy to .env.local for local development. All VITE_* values are bundled into the
# client and are therefore public — never put a secret here.

# Required
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Optional
VITE_SUPABASE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN_FRONTEND=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
# Days after which a password sign-in is required again (default 2, 0 disables)
VITE_FORCE_PASSWORD_REAUTH_DAYS=2

# Edge function secrets (set with `npx supabase secrets set`, NOT here):
# GEMINI_API_KEY, AI_ALLOWED_ORIGINS, SENTRY_DSN_BACKEND, ...
